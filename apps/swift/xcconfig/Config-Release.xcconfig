PACKRAT_ENV = production
PACKRAT_DISPLAY_NAME = PackRat

// SENTRY_DSN flows xcconfig → Info.plist → runtime. Set this in the build
// environment (CI secret, Release-build script, or Config-Release.local.xcconfig
// — gitignored) for production crash reporting. Empty value disables Sentry.
SENTRY_DSN =

// REVENUECAT_API_KEY flows xcconfig → Info.plist → runtime, like SENTRY_DSN.
// This is the Apple *public* SDK key. It ships inside the app binary by
// design and is safe in version control — it can only read offerings and
// make purchases as the signed-in user. The secret key (sk_...) is what
// must never appear here.
REVENUECAT_API_KEY = appl_rnWelSVCsFFZVbcedvupYEUjNyq

// MAPBOX_PUBLIC_TOKEN flows xcconfig → Info.plist (MBXAccessToken) → Mapbox SDK.
// A public (pk.) token ships inside the app binary by design, like the
// RevenueCat key above. Secret (sk.) tokens must never appear here.
MAPBOX_PUBLIC_TOKEN = pk.eyJ1IjoiYW5kcmV3Ymllcm1hbiIsImEiOiJjbDhwYTVtc3kwMGprM3Buejg3d2doa2pvIn0.F_D3I0KRlQkQK70DkK7MlQ
