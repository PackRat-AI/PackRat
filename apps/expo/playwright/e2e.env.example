# Copy to apps/expo/.env.e2e for local Playwright E2E runs.
# The runner keeps this file out of the client bundle and temporarily projects
# EXPO_PUBLIC_* values into .env.local because Expo inlines dotenv values.

API_PORT=8797
WEB_PORT=8097
API_URL=http://localhost:8797
BASE_URL=http://localhost:8097
AUTH_ORIGIN=http://localhost:8097
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/snap/bin/chromium

EXPO_PUBLIC_API_URL=http://localhost:8797
EXPO_PUBLIC_E2E_GEOCODE=true
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=e2e-dummy

# Enable only when you want the suite to spend real AI tokens.
RUN_AI_E2E=false
