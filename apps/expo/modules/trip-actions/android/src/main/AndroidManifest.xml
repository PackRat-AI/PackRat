<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!-- Gemini and other assistants run trip commands through this. Generated by the AppFunctions compiler. -->
    <service
      android:name="world.packrat.tripactions.TripActionsAppFunctionService"
      android:exported="true"
      android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
      tools:targetApi="36">
      <property
        android:name="android.app.appfunctions.schema"
        android:value="app_functions_schema.xsd" />
      <property
        android:name="android.app.appfunctions.v2"
        android:value="trip_actions_app_functions.xml" />
      <intent-filter>
        <action android:name="android.app.appfunctions.AppFunctionService" />
      </intent-filter>
    </service>
    <property
      android:name="android.app.appfunctions.app_metadata"
      android:resource="@xml/trip_actions_app_metadata" />

    <!-- Runs the command in JavaScript, starting it without a screen when PackRat isn't open. -->
    <service
      android:name="world.packrat.tripactions.TripCommandTaskService"
      android:exported="false" />
  </application>
</manifest>
