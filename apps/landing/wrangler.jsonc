{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "packrat-landing",
  "compatibility_date": "2024-09-23",
  // Runs only for shared-post links, to give each one its own link-preview
  // tags. Everything else is served from `out/` without invoking it.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/p/*"]
  },
  "vars": {
    "PACKRAT_API_URL": "https://packrat-api.orange-frost-d665.workers.dev"
  }
}
